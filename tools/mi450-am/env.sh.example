# Copy to env.sh and edit. Every script here sources it.
#
# These three paths are the only machine-specific state. The scripts shipped at
# the repo root hardcode /home/claudeuser, which was the container that the port
# was originally developed in; the tree has since moved, so nothing there
# resolves. Set these instead.
export FLEET=${FLEET:-$HOME/fleet-mi450}
export TOOLCHAIN=${TOOLCHAIN:-$HOME/mi450-toolchain}
export FFM_PKG=${FFM_PKG:-$HOME/rocdtif-10.1-am+ffmlite-mi400-r9.03}

# Optional: only needed if the HOST glibc is older than 2.38. The model package
# requires >=2.38. A bare Ubuntu 24.04 host already satisfies this and needs no
# sysroot; the original container (Ubuntu 22.04, glibc 2.35) did, which is why
# the root-level run_ffm.sh has a loader shim.
export SYSROOT=${SYSROOT:-}
