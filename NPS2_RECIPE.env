# SPX/NPS2 decode recipe for gpt-oss-120b bs=1 on MI355X (lane/port_up, patched amdgpu
# with aid_local_* params). Later assignments win. Measured 2026-09-27 on thor-1:
# 1.207-1.212 ms/token (6/6) vs upstream + its recipe in SPX/NPS1 1.322 (3/3).
# Usage: ./run_nps2_best.sh  (inside the fleet container; SPX/NPS2 with the patched driver)
# fleet_run_lane.sh defaults (LANE_ENVS), applied before the recipe:
MPK_TERM_RECHECK=1
MPK_NARROW_GATE_POLL=1
MPK_AID_SPLIT_FLAGS=1
MPK_AID_SPLIT_OUT=1
MPK_MOE_XCD_PAIR=0
MPK_MOE_REPLICA=1
MPK_AID_EVCTR2=1
MPK_SWIGLU_AID=1
MPK_LMNORM_AID=1
MPK_MOENORM_AID=1
MPK_PRENORM_AID=1
MPK_GAMMA_AID=1
# recipe:
MPK_MOE_NARROW_RELEASE=1
MPK_SWIGLU_AIDREP=1
MPK_OPROJ_NARROW_REL=1
MPK_LM_OWN_BO=1
MPK_ITER_XCD_POLL=1
MPK_ITER_AID=1
MPK_LOCAL_TOPK=1
MPK_MOE_XCD_PAIR=1
MPK_OWN_BO_ALIGN=1
MPK_OWN_BO_PAT=down_proj,qkv_mxfp4,o_proj_mxfp4,gate_up_bias,down_bias,moe_gate,gate_up_proj
MPK_MOE_BIAS_REP=1
MPK_P9_PREINV=1
MPK_SCHED_ONE_FENCE=1
MPK_W13_HOF_AIDREP=1
MPK_W2_GATHER_NO_NT=1
MPK_KV_HEAD_MAJOR=1
MPK_KV_OWN_BO=1
MPK_LAYER_RING=1
MPK_P9_PREINV_SKIP=1
MPK_W2_KWIN=8
