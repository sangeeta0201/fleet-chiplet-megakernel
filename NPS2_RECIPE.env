MPK_ATTN_WL_DMA=4
MPK_KV_CHUNKS_ADAPTIVE=1
MPK_KV_SW_IDLE=1
MPK_ATTN_WL_NT=1
MPK_KV_FULL_IDLE=1
MPK_CHAT_DATE=2026-09-25
MPK_LTK_DPP=1
MPK_OPROJ_AMAX_DPP=1
MPK_PQ_AMAX_DPP=1
