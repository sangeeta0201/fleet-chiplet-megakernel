# standalone kernel test binaries (tests/standalone/build.sh).
# Pattern, not an enumeration -- the explicit list went stale and left ~15
# untracked ELFs in the tree.  Sources are re-admitted by the negations.
tests/standalone/test_*
!tests/standalone/test_*.hip
!tests/standalone/test_*.cpp
!tests/standalone/test_*.cu
!tests/standalone/test_*.py
!tests/standalone/test_*.sh

